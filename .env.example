# Cell Storage Management System - 环境配置示例
# 复制此文件为 .env 并填写实际值

# ==================== Flask配置 ====================
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production
BLUEHOST_DEPLOYMENT=true

# ==================== 数据库配置 ====================
# PostgreSQL配置（VPS环境）
DB_USER=cellstorage_user
DB_PASS=your_database_password_here
DB_NAME=cell_storage
DB_HOST=localhost
DB_PORT=5432

# MySQL配置（共享主机环境）
# DB_USER=cellstorage_user
# DB_PASS=your_database_password_here
# DB_NAME=cell_storage
# DB_HOST=localhost
# DB_PORT=3306

# ==================== 服务器配置 ====================
SERVER_NAME=hayerlab.org
APPLICATION_ROOT=/

# ==================== 打印服务配置 ====================
CENTRALIZED_PRINTING_ENABLED=false
PRINT_SERVER_URL=http://localhost:5001
PRINT_API_TOKEN=your-secure-print-token-here

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=/var/log/cellstorage/app.log

# ==================== 邮件配置（可选） ====================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@hayerlab.org

# ==================== 文件上传配置 ====================
UPLOAD_FOLDER=/var/www/cellstorage/uploads
MAX_CONTENT_LENGTH=16777216

# ==================== 缓存配置 ====================
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ==================== 时区配置 ====================
TIMEZONE=America/New_York
